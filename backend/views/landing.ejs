<%- include('partials/header', { title: 'OnDemand Marketplace' }) %>
<section
  class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white">
  <div
    class="absolute inset-0 opacity-10"
    style="
      background-image: linear-gradient(
          rgba(255, 255, 255, 0.1) 1px,
          transparent 1px
        ),
        linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
      background-size: 48px 48px;
    "></div>
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-blue-500 opacity-10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-6 py-28 text-center">
    <div
      class="inline-flex items-center gap-2 px-4 py-1.5 bg-blue-500/20 border border-blue-400/30 rounded-full text-blue-300 text-xs font-semibold tracking-widest uppercase mb-8">
      <span class="w-1.5 h-1.5 bg-blue-400 rounded-full animate-pulse"></span>
      The All-in-One Vendor Marketplace
    </div>

    <h1
      class="text-5xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-none mb-6">
      One Platform.<br />
      <span class="text-blue-400">Every Vendor.</span>
    </h1>

    <p class="max-w-2xl mx-auto text-lg text-slate-300 leading-relaxed mb-10">
      OnDemand connects customers with trusted vendors offering products and
      services. Browse, compare, book, and buy — all in one integrated digital
      marketplace.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/products"
        class="w-full sm:w-auto px-8 py-3.5 bg-blue-500 hover:bg-blue-400 text-white font-bold rounded-xl shadow-lg shadow-blue-500/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-blue-500/30 text-sm"
        >Browse Products</a
      >
      <a
        href="/register"
        class="w-full sm:w-auto px-8 py-3.5 bg-white/10 hover:bg-white/20 border border-white/20 hover:border-white/30 text-white font-bold rounded-xl backdrop-blur transition-all hover:-translate-y-0.5 text-sm"
        >Join as Vendor →</a
      >
    </div>
  </div>

  <div
    class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white to-transparent"></div>
</section>

<section class="bg-white border-b border-slate-100">
  <div
    class="max-w-6xl mx-auto px-6 py-10 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
    <% stats.forEach(function(stat) { %>
    <div>
      <div class="text-3xl font-black text-blue-600 tracking-tight">
        <%= stat.value %>
      </div>
      <div class="text-sm text-slate-500 mt-1 font-medium">
        <%= stat.label %>
      </div>
    </div>
    <% }); %>
  </div>
</section>

<section class="bg-slate-50 py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14">
      <p class="text-blue-600 text-sm font-bold uppercase tracking-widest mb-3">
        Why OnDemand
      </p>
      <h2 class="text-4xl font-black text-slate-900 tracking-tight">
        Everything you need, in one place
      </h2>
      <p class="mt-4 text-slate-500 text-lg max-w-xl mx-auto">
        Whether you're shopping for goods or booking a service, OnDemand has you
        covered.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% features.forEach(function(feature) { %>
      <div
        class="bg-white rounded-2xl p-8 border border-slate-200 <%= feature.border %> shadow-sm hover:shadow-md transition-all duration-200 group">
        <div
          class="w-14 h-14 rounded-xl flex items-center justify-center mb-5 <%= feature.accent %>">
          <% if (feature.icon === 'shopping-bag') { %>
          <svg
            class="w-7 h-7"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
          </svg>
          <% } else if (feature.icon === 'calendar') { %>
          <svg
            class="w-7 h-7"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
          <% } else if (feature.icon === 'shield-check') { %>
          <svg
            class="w-7 h-7"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.745 3.745 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.745 3.745 0 013.296-1.043A3.745 3.745 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.745 3.745 0 013.296 1.043 3.745 3.745 0 011.043 3.296A3.745 3.745 0 0121 12z" />
          </svg>
          <% } %>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-2">
          <%= feature.title %>
        </h3>
        <p class="text-slate-500 text-sm leading-relaxed">
          <%= feature.description %>
        </p>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="bg-blue-600 py-20 px-6 text-center text-white">
  <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-4">
    Ready to grow your business?
  </h2>
  <p class="text-blue-100 text-lg mb-8 max-w-lg mx-auto">
    Join thousands of vendors already thriving on OnDemand. Setup takes less
    than 5 minutes.
  </p>
  <a
    href="/register"
    class="inline-block px-8 py-3.5 bg-white text-blue-600 font-bold rounded-xl hover:bg-blue-50 transition-colors shadow-lg text-sm"
    >Start Selling Today</a
  >
</section>

<%- include('partials/footer', { year: year }) %>
